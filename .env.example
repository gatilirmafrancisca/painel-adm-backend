MONGODB_URI=mongodb://root:example@localhost:27017
MONGODB_DB_NAME=example
# Obrigatório, 32+ caracteres (npm run generate-secret-key). Sem ele o painel não sobe.
JWT_SECRET=
# Mesmo banco do backend da rifa (coleção rifas) — nome do database.
MONGODB_RIFA_NAME=
# Origem do painel-adm-frontend (CORS).
FRONTEND_URL=http://localhost:5173

CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=seu_api_secret

PORT=3000

MERCADOPAGO_BACKEND_INTERNAL_SECRET=seu_segredo_interno_aqui

# Site da rifa: monta o link de escolha do número no painel (ex: https://www.gatilirmafrancisca.org)
RIFA_SITE_URL=
